[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/game/hud/hud.gd" id="1_hud"]
[ext_resource type="PackedScene" path="res://scenes/game/hud/sanity_meter.tscn" id="2_meter"]
[ext_resource type="PackedScene" path="res://scenes/game/hud/inventory_list.tscn" id="3_list"]
[ext_resource type="PackedScene" path="res://scenes/game/hud/debug_state_label.tscn" id="4_debug"]
[ext_resource type="PackedScene" path="res://scenes/game/hud/controls_label.tscn" id="5_controls"]
[ext_resource type="PackedScene" path="res://scenes/game/hud/pickup_toast.tscn" id="6_toast"]

[sub_resource type="Theme" id="Theme_hud"]
Label/font_sizes/font_size = 20

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Margin" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = SubResource("Theme_hud")
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="Player" type="VBoxContainer" parent="Margin"]
layout_mode = 2
size_flags_horizontal = 0
size_flags_vertical = 0
mouse_filter = 2
theme_override_constants/separation = 8

[node name="SanityMeter" parent="Margin/Player" instance=ExtResource("2_meter")]
layout_mode = 2

[node name="InventoryList" parent="Margin/Player" instance=ExtResource("3_list")]
layout_mode = 2

[node name="DebugStateLabel" parent="Margin/Player" instance=ExtResource("4_debug")]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="ControlsLabel" parent="Margin" instance=ExtResource("5_controls")]
layout_mode = 2
size_flags_horizontal = 8
size_flags_vertical = 0

[node name="PickupToast" parent="Margin" instance=ExtResource("6_toast")]
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 8
