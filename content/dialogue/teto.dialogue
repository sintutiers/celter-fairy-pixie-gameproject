~ teto_reward_passed_exam
if get_fact("teto.exams_passed", 0) < 3
	$> set_fact("teto.exams_passed", get_fact("teto.exams_passed", 0) + 1)
	$> add_favor("teto", 1)
	Teto: [rainbow sat=1][b]PASSED![/b][/rainbow] I owe you {{get_favor("teto")}}. [color=#777]i always pay! nobody ever asks me what with.[/color] [ID:baupjsuxjq75l_57481d]
else
	Teto: Passed again. [wait=0.6] You can stop now, you know. [ID:baupjsuxjq75l_9a69eb]
=> teto_choose_topic


~ teto_say_her_name
$> add_sanity(10)
Teto: [wait=1.0] ...[rainbow freq=0.2 sat=0.5]Kasane Teto.[/rainbow] [ID:baupjsuxjq75l_16500e]
Teto: You said it like a real name. People usually laugh after. [ID:baupjsuxjq75l_580ab7]
Teto: You did not laugh. [ID:baupjsuxjq75l_7879f0]
if get_fact("teto.has_name")
	=> teto_choose_topic
Teto: Will you tell me yours? [ID:baupjsuxjq75l_81be58]
- Tell her your name. [ID:baupjsuxjq75l_dedf79]
	$> set_fact("teto.has_name")
	$> add_opinion("teto", 1)
	## she has the players name now. nothing uses it yet.
	Teto: Thank you. [wait=0.8] I will look after it. [ID:baupjsuxjq75l_88274b]
- Not today. [ID:baupjsuxjq75l_b4ff02]
	Teto: Good. Do not give it to anyone back here. [wait=0.8] Not even me. [ID:baupjsuxjq75l_2a5545]
=> teto_choose_topic


~ teto_punish_wrong_answer
$> set_fact("teto.wrong", get_fact("teto.wrong", 0) + 1)
$> add_opinion("teto", -1)
$> add_sanity(-5)
match get_fact("teto.wrong", 0)
	when 1
		[[Teto|TETO|T E T O]]: [#jumpscare] [shake rate=40 level=25][font_size=40][b]WRONG.[/b][/font_size][/shake] [ID:baupjsuxjq75l_d578af]
		Teto: Sorry! Sorry! That was loud. [color=#777]i will do the next one closer to your ear.[/color] [ID:baupjsuxjq75l_a824c5]
	when 2
		[[Teto|TETO|T E T O]]: [#jumpscare] [shake rate=40 level=25][font_size=40][b]AGAIN.[/b][/font_size][/shake] [ID:baupjsuxjq75l_d477ac]
		Teto: [color=#777]two. your hands are shaking. hold them out, i want to count the fingers.[/color] [ID:baupjsuxjq75l_c81590]
	when 3
		[[Teto|TETO|T E T O]]: [#jumpscare] [#sanity_glitch] [font_size=40][b]Three.[/b][/font_size] [ID:baupjsuxjq75l_d2c2df]
		Teto: [#sanity_glitch] I wrote it on the inside of the bag. [color=#777]you will read it later, from the inside.[/color] [ID:baupjsuxjq75l_cd8285]
	else
		$> set_fact("teto.evicted")
		[[Teto|TETO|T E T O]]: [#jumpscare] [#sanity_glitch] [shake rate=60 level=40][font_size=56][b]ENOUGH.[/b][/font_size][/shake] [ID:baupjsuxjq75l_f1eef4]
		Teto: We are leaving. [wait=0.8] [color=#777]when you get home, check behind your door before you lock it.[/color] [ID:baupjsuxjq75l_a652b5]
		=> END!
=> END


~ teto_after_eviction
Behind the box: crumbs, an empty saucer and a long drag mark. A note says [i]"you know what you did."[/i] [ID:baupjsuxjq75l_7eef2b]
- Leave two bread. [if has_item("bread", 2) /] [ID:baupjsuxjq75l_ac50c5]
	$> remove_item("bread", 2)
	$> set_fact("teto.evicted", false)
	$> set_fact("teto.wrong", 0)
	$> add_opinion("teto", 1)
	Teto: [rainbow sat=1]Welcome back![/rainbow] I was standing right behind you. [color=#777]you walked past me twice.[/color] [ID:baupjsuxjq75l_ac31e4]
	=> teto
- Leave. [ID:baupjsuxjq75l_f95bac]
	=> END
