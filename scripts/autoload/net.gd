## Multiplayer through SpacetimeDB. Autoload it as "Net".
## Connects on startup + keeps one remote /net_player row of other players.
## Local player publishes through [method send_local_player_state], see [NetSyncComponent].
## Remotes are shown as [RemotePlayer]/[RemotePlayer2D], whichever matches local player,
## ∴ players in 2D level see each other in 2D. Row carries no dimension, 2D uses z = 0.
## Failed connection is reported once + game keeps running offline.
## [code]--offline[/code] after [code]--[/code] skips connecting.
## ⚠ [code]SpacetimeDB.Faerie[/code] + [code]FaerieNetPlayer[/code] are generated by
## SDK from module in server/. Regenerate schema after changing it.
extends Node

const HOST: String = "https://maincloud.spacetimedb.com"
const MODULE_NAME: String = "faerie"
const REMOTE_SCENE: PackedScene = preload("res://scenes/game/remote_player.tscn")
const REMOTE_SCENE_2D: PackedScene = preload("res://scenes/game/remote_player_2d.tscn")

# generated module client, untyped ∴ _ready is only place naming generated class
var _module
# true once local player published from 2D body
var _is_local_player_2d: bool = false
# keyed by hex identity, PackedByteArray is poor dictionary key
# RemotePlayer/RemotePlayer2D: share apply_net_player_row() but no base class
var _remotes: Dictionary[String, Node] = { }


func _ready() -> void:
	_module = SpacetimeDB.Faerie
	# CI test run passes it after -- ∴ tests never reach maincloud + fail on its errors
	if "--offline" in OS.get_cmdline_user_args():
		return
	_module.connected.connect(_on_connected)
	_module.disconnected.connect(_on_disconnected)
	_module.connection_error.connect(_on_connection_error)
	var options: SpacetimeDBConnectionOptions = SpacetimeDBConnectionOptions.new()
	# fresh identity /run ∴ two clients on one machine dont share row
	options.one_time_token = true
	_module.connect_db(HOST, MODULE_NAME, options)


# leave cleanly ∴ server drops our row at once
func _notification(what: int) -> void:
	if what == NOTIFICATION_WM_CLOSE_REQUEST and _module.is_connected_db():
		_module.disconnect_db()


## Publishes local player state. Does ∅ while disconnected,
## connection error was already reported. [param is_2d] picks remote scene
## other players are shown w/, 2D player passes its position w/ z = 0.
func send_local_player_state(position: Vector3, flip_h: bool, animation: StringName, is_2d: bool = false) -> void:
	_is_local_player_2d = is_2d
	if not _module.is_connected_db():
		return
	var reducer_call: SpacetimeDBReducerCall = _module.reducers.update_net_player(position.x, position.y, position.z, flip_h, String(animation), GameState.get_current_level_path())
	if reducer_call.error != OK:
		Log.error("net: update_net_player was not sent (%s)" % error_string(reducer_call.error))
		return
	reducer_call.on_error.connect(_on_reducer_error)


func _on_connected(_identity: PackedByteArray, _token: String) -> void:
	var subscription: SpacetimeDBSubscription = _module.subscribe(["SELECT * FROM net_player"])
	if subscription.error != OK:
		Log.error("net: subscribe failed (%s)" % error_string(subscription.error))
		return
	subscription.applied.connect(_on_subscription_applied)


func _on_disconnected() -> void:
	Log.warn("net: disconnected")
	for id: String in _remotes.keys():
		_release_remote_player(id)


func _on_connection_error(code: int, reason: String) -> void:
	Log.error("net: connection failed (%d): %s" % [code, reason])


func _on_reducer_error(message: String) -> void:
	Log.error("net: reducer failed: %s" % message)


# local db only guaranteed once subscription is applied
# register before iterating ∴ no row is missed, _apply_net_player_row is idempotent for rows seen twice
func _on_subscription_applied() -> void:
	var table: FaerieNetPlayerTable = _module.db.net_player
	table.on_insert(_apply_net_player_row)
	table.on_update(_on_net_player_row_updated)
	table.on_delete(_on_net_player_row_deleted)
	for row: FaerieNetPlayer in table.iter():
		_apply_net_player_row(row)


func _on_net_player_row_updated(_previous: FaerieNetPlayer, row: FaerieNetPlayer) -> void:
	_apply_net_player_row(row)


func _on_net_player_row_deleted(row: FaerieNetPlayer) -> void:
	var id: String = row.identity.hex_encode()
	if _remotes.has(id):
		_release_remote_player(id)


# insert + update are same here: spawn remote if missing > apply
func _apply_net_player_row(row: FaerieNetPlayer) -> void:
	if row.identity == _module.get_local_identity():
		return
	var id: String = row.identity.hex_encode()
	var scene: PackedScene = REMOTE_SCENE_2D if _is_local_player_2d else REMOTE_SCENE
	var remote: Node = _remotes.get(id)
	# local player changed dimension since this remote was made
	if remote and remote.scene_file_path != scene.resource_path:
		_release_remote_player(id)
		remote = null
	if not remote:
		remote = _spawn_remote_player(scene)
		if not remote:
			return
		_remotes[id] = remote
	remote.apply_net_player_row(row)
	remote.visible = row.level == GameState.get_current_level_path()


func _spawn_remote_player(scene: PackedScene) -> Node:
	var remote: Node = scene.instantiate()
	if not remote.has_method(&"apply_net_player_row"):
		Log.error("net: %s root has no apply_net_player_row(), it is not a remote player" % scene.resource_path)
		remote.free()
		return null
	add_child(remote)
	return remote


func _release_remote_player(id: String) -> void:
	_remotes[id].queue_free()
	_remotes.erase(id)
